# Copie este ficheiro para .env e preencha os valores.

HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Mude em producao!
SECRET_KEY=bankao_dev_secret_key_change_in_prod

# ===========================================================================
# META GLOBAL AI DEVELOPER HACKATHON - BASETEN & META MUSE SPARK OPEN
# ===========================================================================
# Provedor ativo: "baseten" (Hackathon 2M tokens/min), "meta" ou "auto"
AI_PROVIDER=auto

# Chave de API da Baseten para o modelo Meta Muse Spark Open ($100 credits, 2M tokens/min)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Meta Direct API / Fallback
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3

# Parametros de Inferencia & Reasoning do Muse Spark Open
AI_MAX_TOKENS=3500
AI_TEMPERATURE=0.2
AI_REQUEST_TIMEOUT=45
AI_ENABLE_REASONING_TRACE=true

# Caminho relativo = a partir da raiz do projeto
DATABASE_PATH=bankao.db
DATABASE_URL=sqlite:///./bankao.db

# ===========================================================================
# ELEVENLABS (Voz conversacional -- opt-in)
# Obtenha as credenciais em: https://elevenlabs.io/app/conversational-ai
# ===========================================================================
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Segredo partilhado para autenticar o Custom LLM ElevenLabs (gere um UUID aleatorio)
ELEVENLABS_CUSTOM_LLM_SECRET=
